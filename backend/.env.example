# Copier vers .env — ne jamais committer de vraies valeurs.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Sans DATABASE_URL, le mode développement utilise un Postgres embarqué (PGlite) dans backend/.data
# DATABASE_URL=postgres://app:app@localhost:5432/app
# Sans REDIS_URL, le mode développement utilise un store mémoire (mono-instance uniquement)
# REDIS_URL=redis://localhost:6379

# Clé privée Ed25519 au format PKCS8 PEM (obligatoire en production).
# Génération : openssl genpkey -algorithm ed25519
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# JWT_ISSUER=https://api.exemple.com

# Nom du produit affiché dans les e-mails (voir brand/brand.json)
APP_NAME=App
WEB_URL=http://localhost:3000

# Sans SMTP_URL, le mode développement affiche les e-mails dans le terminal.
# Boîte IONOS : smtps://adresse%40domaine.com:motdepasse@smtp.ionos.fr:465
# SMTP_URL=
# MAIL_FROM="App <no-reply@exemple.com>"

# Connexion Google et Discord (facultatif). Un fournisseur n'est proposé que si ses deux
# valeurs sont remplies. URI de redirection à déclarer chez lui :
#   http://localhost:4000/v1/auth/oauth/google/callback   (ou /discord/callback)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=

ACCESS_TOKEN_TTL_SEC=600
REFRESH_TOKEN_TTL_DAYS=30
# true uniquement derrière un reverse proxy de confiance (sinon l'IP cliente est falsifiable)
TRUST_PROXY=false
